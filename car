        class Helicopter {
            constructor() {
                this.active = false;
                this.x = 0;
                this.y = 0;
                this.angle = 0;
                this.rotorAngle = 0;
                this.speed = 4.0;
                this.spotlightAngle = 0;
            }

            spawn(px, py) {
                this.active = true;
                this.x = px + (Math.random() < 0.5 ? -700 : 700);
                this.y = py + (Math.random() < 0.5 ? -700 : 700);
            }

            update(targetX, targetY) {
                if (!this.active) return;
                this.rotorAngle += 0.5;
                this.spotlightAngle += 0.035;

                const dx = targetX - this.x;
                const dy = targetY - this.y;
                const dist = Math.hypot(dx, dy);

                this.angle = Math.atan2(dy, dx);

                if (dist > 20) {
                    this.x += Math.cos(this.angle) * Math.min(this.speed, dist * 0.04);
                    this.y += Math.sin(this.angle) * Math.min(this.speed, dist * 0.04);
                }
            }

            drawGroundEffects(ctx) {
                if (!this.active) return;

                const spotX = this.x + Math.cos(this.spotlightAngle) * 20;
                const spotY = this.y + Math.sin(this.spotlightAngle) * 20;

                ctx.save();
                const grad = ctx.createRadialGradient(spotX, spotY, 5, spotX, spotY, 85);
                grad.addColorStop(0, 'rgba(254, 240, 138, 0.55)');
                grad.addColorStop(0.5, 'rgba(250, 204, 21, 0.25)');
                grad.addColorStop(1, 'rgba(250, 204, 21, 0)');

                ctx.fillStyle = grad;
                ctx.beginPath();
                ctx.arc(spotX, spotY, 85, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();
            }

            drawHelicopter(ctx) {
                if (!this.active) return;

                ctx.save();
                ctx.translate(this.x, this.y);
                ctx.rotate(this.angle);

                ctx.fillStyle = '#0f172a';
                ctx.fillRect(-45, -3, 30, 6);

                ctx.fillStyle = '#ef4444';
                ctx.fillRect(-48, -9, 4, 18);

                ctx.fillStyle = '#1e3a8a';
                ctx.beginPath();
                ctx.ellipse(0, 0, 24, 12, 0, 0, Math.PI * 2);
                ctx.fill();

                ctx.fillStyle = '#ffffff';
                ctx.fillRect(-10, -8, 20, 16);
                ctx.fillStyle = '#000000';
                ctx.font = 'bold 8px sans-serif';
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                ctx.fillText('POLICE', 0, 1);

                ctx.fillStyle = '#38bdf8';
                ctx.beginPath();
                ctx.ellipse(13, 0, 8, 8, 0, 0, Math.PI * 2);
                ctx.fill();

                const isFlash = Math.floor(Date.now() / 120) % 2 === 0;
                ctx.fillStyle = isFlash ? '#ef4444' : '#3b82f6';
                ctx.beginPath();
                ctx.arc(20, 0, 4, 0, Math.PI * 2);
                ctx.fill();

                ctx.save();
                ctx.rotate(this.rotorAngle);
                ctx.strokeStyle = 'rgba(248, 250, 252, 0.85)';
                ctx.lineWidth = 3;
                ctx.beginPath();
                ctx.moveTo(-44, 0); ctx.lineTo(44, 0);
                ctx.moveTo(0, -44); ctx.lineTo(0, 44);
                ctx.stroke();
                ctx.restore();

                ctx.restore();
            }
        }

