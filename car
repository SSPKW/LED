            if (e.code === 'Space') keys.drift = true;
            if (e.code === 'KeyH') { audio.playHorn(); showToast("📣 叭叭！電單車響號！"); }
            if (e.code === 'KeyR') resetPlayer();
        });

        window.addEventListener('keyup', (e) => {
            if (e.code === 'KeyW' || e.code === 'ArrowUp') keys.forward = false;
            if (e.code === 'KeyS' || e.code === 'ArrowDown') keys.backward = false;
            if (e.code === 'KeyA' || e.code === 'ArrowLeft') keys.left = false;
            if (e.code === 'KeyD' || e.code === 'ArrowRight') keys.right = false;
            if (e.code === 'ShiftLeft' || e.code === 'ShiftRight') keys.nitro = false;
            if (e.code === 'Space') keys.drift = false;
        });

        window.addEventListener('mousemove', (e) => {
            mouse.x = e.clientX;
            mouse.y = e.clientY;
            mouse.activeMode = true;
        });

        window.addEventListener('touchmove', (e) => {
            if (e.touches.length > 0) {
                mouse.x = e.touches[0].clientX;
                mouse.y = e.touches[0].clientY;
                mouse.activeMode = true;
            }
        }, { passive: true });

        window.addEventListener('mousedown', () => { audio.init(); mouse.activeMode = true; });
        window.addEventListener('contextmenu', (e) => e.preventDefault());

        function bindTouch(id, keyProp) {
            const btn = document.getElementById(id);
            if (!btn) return;
            btn.addEventListener('touchstart', (e) => { e.preventDefault(); keys[keyProp] = true; audio.init(); });
            btn.addEventListener('touchend', (e) => { e.preventDefault(); keys[keyProp] = false; });
            btn.addEventListener('mousedown', () => { keys[keyProp] = true; audio.init(); });
            btn.addEventListener('mouseup', () => { keys[keyProp] = false; });
        }
        bindTouch('t-left', 'left');
        bindTouch('t-right', 'right');
        bindTouch('t-brake', 'backward');
        bindTouch('t-nitro', 'nitro');

        const centerGasBtn = document.getElementById('btn-gas-center');
        if (centerGasBtn) {
            const startGas = (e) => {
                if (e) e.preventDefault();
                keys.forward = true;
                audio.init();
            };
            const stopGas = (e) => {
                if (e) e.preventDefault();
                keys.forward = false;
            };

            centerGasBtn.addEventListener('pointerdown', startGas);
            centerGasBtn.addEventListener('pointerup', stopGas);
            centerGasBtn.addEventListener('pointerleave', stopGas);
            centerGasBtn.addEventListener('pointercancel', stopGas);
        }
        
        document.getElementById('t-horn').addEventListener('click', () => { audio.playHorn(); showToast("📣 叭叭！電單車響號！"); });

        document.getElementById('btn-start').addEventListener('click', () => {
            audio.init();
            document.getElementById('start-modal').classList.add('hidden');
        });

        document.getElementById('btn-radio-next').addEventListener('click', () => {
            const name = audio.nextRadio();
            document.getElementById('hud-radio').innerText = name;
        });
        document.getElementById('btn-radio-prev').addEventListener('click', () => {
            const name = audio.prevRadio();
            document.getElementById('hud-radio').innerText = name;
        });
        document.getElementById('btn-audio-toggle').addEventListener('click', () => {
            audio.init();
        });

        function showToast(msg) {
            const toast = document.getElementById('toast-msg');
            toast.innerText = msg;
            toast.classList.remove('opacity-0', '-translate-y-2');
            toast.classList.add('opacity-100', 'translate-y-0');
            setTimeout(() => {
                toast.classList.add('opacity-0', '-translate-y-2');
                toast.classList.remove('opacity-100', 'translate-y-0');
            }, 2600);
        }

        function resetPlayer() {
            player.x = TILE_SIZE * 10.5;
            player.y = TILE_SIZE * 10.5;
            player.speed = 0;
            player.angle = 0;
            showToast("🏍️ 電單車已返回福榮街起點！");
        }

        function spawnPoliceCar() {
            let px, py, attempts = 0;
            do {
                const angle = Math.random() * Math.PI * 2;
                const dist = 380 + Math.random() * 200;
                px = player.x + Math.cos(angle) * dist;
                py = player.y + Math.sin(angle) * dist;
                
                const tc = Math.floor(px / TILE_SIZE);
                const tr = Math.floor(py / TILE_SIZE);
                if (tc >= 1 && tc < MAP_SIZE - 1 && tr >= 1 && tr < MAP_SIZE - 1 && cityGrid[tr][tc] !== TILE.BUILDING) {
                    policeCars.push(new TrafficCar(px, py, true));
                    break;
                }
                attempts++;
            } while (attempts < 25);
        }

        function updatePhysics() {
            if (mouse.activeMode) {
                const dx = mouse.x - canvas.width / 2;
                const dy = mouse.y - canvas.height / 2;
                const targetAngle = Math.atan2(dy, dx);
                let diff = targetAngle - player.angle;
                while (diff < -Math.PI) diff += Math.PI * 2;
                while (diff > Math.PI) diff -= Math.PI * 2;
                player.angle += diff * 0.12;
                player.leanAngle = diff;
            } else {
                if (keys.left) {
                    player.angle -= player.turnSpeed * (player.speed < 0 ? -1 : 1);
                    player.leanAngle = -0.6;
                } else if (keys.right) {
                    player.angle += player.turnSpeed * (player.speed < 0 ? -1 : 1);
                    player.leanAngle = 0.6;
                } else {
                    player.leanAngle = 0;
                }
            }

            // 檢查玩家是否到達深水埔街坊福利會小學
            const schoolBuilding = buildingsList.find(b => b.type === 'school');
            if (schoolBuilding) {
                const isNearSchool = (
                    player.x >= schoolBuilding.x - 30 &&
                    player.x <= schoolBuilding.x + schoolBuilding.w + 30 &&
                    player.y >= schoolBuilding.y - 30 &&
                    player.y <= schoolBuilding.y + schoolBuilding.h + 30
                );
                const now = Date.now();
                if (isNearSchool && (now - player.lastSchoolHealTime >= 60000)) { 
                    player.lastSchoolHealTime = now;
                    policeFreezeEndTime = now + 30000; 
                    const healAmount = 3;
                    player.health = Math.min(player.maxHealth, player.health + healAmount);
                    updateHealthHUD();
                    audio.playBookSound();
                    showToast("🏫 抵達深水埔街坊福利會小學！成功補回 3 個機會，所有警車停止行駛 30 秒！");
                }
            }

            let maxSpd = player.maxSpeed;
            if (keys.nitro && player.nitro > 0) {
                maxSpd *= 1.48;
                player.nitro = Math.max(0, player.nitro - 0.6);
                player.isNitroActive = true;
            } else {
                player.isNitroActive = false;
                player.nitro = Math.min(100, player.nitro + 0.12);
            }

            if (keys.forward) {
                player.speed = Math.min(maxSpd, player.speed + player.accel);
            } else if (keys.backward) {
                player.speed = Math.max(player.reverseMaxSpeed, player.speed - player.accel);
            } else {
                player.speed *= player.friction;
                if (Math.abs(player.speed) < 0.05) player.speed = 0;
            }

            player.x += Math.cos(player.angle) * player.speed;
            player.y += Math.sin(player.angle) * player.speed;

            if (Math.abs(player.speed) > 1) {
                player.exhaustParticles.push({
                    x: player.x - Math.cos(player.angle) * 20,
                    y: player.y - Math.sin(player.angle) * 20,
                    size: 3 + Math.random() * 4,
                    alpha: 0.6,
                    color: player.isNitroActive ? '#38bdf8' : '#cbd5e1'
                });
            }

            for (let i = player.exhaustParticles.length - 1; i >= 0; i--) {
                const p = player.exhaustParticles[i];
                p.alpha -= 0.04;
                p.size += 0.2;
                if (p.alpha <= 0) {
                    player.exhaustParticles.splice(i, 1);
                }
            }

            audio.updateEngineSound(Math.abs(player.speed) / player.maxSpeed, keys.forward);

            const minBound = TILE_SIZE + player.width;
            const maxBound = WORLD_BOUNDS - TILE_SIZE - player.width;
            if (player.x < minBound) { player.x = minBound; player.speed = -player.speed * 0.4; audio.playCrash(); }
            if (player.x > maxBound) { player.x = maxBound; player.speed = -player.speed * 0.4; audio.playCrash(); }
            if (player.y < minBound) { player.y = minBound; player.speed = -player.speed * 0.4; audio.playCrash(); }
            if (player.y > maxBound) { player.y = maxBound; player.speed = -player.speed * 0.4; audio.playCrash(); }

            // Building Collisions
            for (let i = 0; i < buildingsList.length; i++) {
                const b = buildingsList[i];
                if (b.type === 'soccer_court' || b.type === 'park') continue; 

                if (player.x + player.width/2 > b.x && 
                    player.x - player.width/2 < b.x + b.w && 
                    player.y + player.length/2 > b.y && 
                    player.y - player.length/2 < b.y + b.h) {

                    audio.playCrash();
                    player.speed = -player.speed * 0.5;
                    
                    const angleToPlayer = Math.atan2(player.y - (b.y + b.h/2), player.x - (b.x + b.w/2));
                    player.x += Math.cos(angleToPlayer) * 7;
                    player.y += Math.sin(angleToPlayer) * 7;
                }
            }

            const nowTime = Date.now();
            bookPickups.forEach(p => {
                if (!p.active && p.respawnTime && nowTime >= p.respawnTime) {
                    const activeCount = bookPickups.filter(b => b.active).length;
                    if (activeCount >= 15) return;

                    let newRx, newRy, validSpot = false, respawnAttempts = 0;
                    while (!validSpot && respawnAttempts < 100) {
                        respawnAttempts++;
                        newRx = Math.floor(Math.random() * (MAP_SIZE - 4)) + 2;
                        newRy = Math.floor(Math.random() * (MAP_SIZE - 4)) + 2;
                        if (cityGrid[newRy][newRx] === TILE.BUILDING) continue;

                        let nearbyCount = 0;
                        for (const other of bookPickups) {
                            if (other === p || !other.active) continue;
                            const obrx = Math.floor(other.x / TILE_SIZE);
                            const obry = Math.floor(other.y / TILE_SIZE);
                            if (Math.hypot(newRx - obrx, newRy - obry) < 16) {
                                nearbyCount++;
                            }
                        }
                        if (nearbyCount < 5) validSpot = true;
                    }

                    if (validSpot) {
                        p.x = newRx * TILE_SIZE + TILE_SIZE / 2;
                        p.y = newRy * TILE_SIZE + TILE_SIZE / 2;
                    }

                    p.active = true;
                    const newBook = getRandomBook();
                    p.title = newBook.name;
                    p.emoji = newBook.emoji;
                }

                if (p.active) {
                    p.pulse += 0.06;
                    p.rotAngle += 0.03;
                    const dist = Math.hypot(player.x - p.x, player.y - p.y);
                    if (dist < 38) {
                        p.active = false;
                        p.respawnTime = nowTime + 30000;
                        player.books += p.amount;
                        audio.playBookSound();
                        updateBookHUD();
                        showToast(`📖 成功收集《${p.title}》${p.emoji}！現有 ${player.books} 本 (30秒後再生)`);
                    }
                }
            });

            const playerR = Math.floor(player.y / TILE_SIZE);
            const playerC = Math.floor(player.x / TILE_SIZE);

            let matchedHoriz = null;
            let matchedVert = null;

            streetLabels.forEach(st => {
                if (st.isHoriz && Math.abs(playerR - st.r) <= 1) {
                    matchedHoriz = st.name;
                }
                if (!st.isHoriz && Math.abs(playerC - st.c) <= 1) {
                    matchedVert = st.name;
                }
            });

            let displayText = "📍 深水埗街道探索中...";
            if (matchedHoriz && matchedVert) {
                const horizName = matchedHoriz.split(' ')[0];
                const vertName = matchedVert.split(' ')[0];
                displayText = `📍 ${horizName} ✕ ${vertName} 交界`;
            } else if (matchedHoriz) {
                displayText = `📍 ${matchedHoriz}`;
            } else if (matchedVert) {
                displayText = `📍 ${matchedVert}`;
            }

            document.getElementById('street-name-text').innerText = displayText;

            trafficCars.forEach(car => {
                car.update();
                const dist = Math.hypot(player.x - car.x, player.y - car.y);
                const minDist = (car.width + car.length) / 4 + 10;
                if (dist < minDist) {
                    if (!car.hitCooldown || car.hitCooldown <= 0) {
                        car.hitCooldown = 30;
                        audio.playCrash();
                        player.speed = -player.speed * 0.6;
                        
                        wantedLevel = Math.min(5, wantedLevel + 1);
                        updateWantedHUD();

                        const typeNames = {
                            bus: '雙層巴士',
                            container: '重型貨櫃車',
                            truck: '貨車',
                            tesla: 'Tesla 電車',
                            motorcycle: '電單車',
                            scooter: '綿羊仔',
                            sedan: '私家車'
                        };
                        const hitName = typeNames[car.type] || '車輛';
                        showToast(`🚨 碰撞${hitName}！通緝度升至 ★${wantedLevel}`);
                        
                        if (policeCars.length < wantedLevel * 2) {
                            spawnPoliceCar();
                        }

                        if (wantedLevel >= 3 && !policeHelicopter.active) {
                            policeHelicopter.spawn(player.x, player.y);
                            showToast("🚁 通緝達 ★3！深水埗警察直升機登場追捕！");
                        }
                    }
                }
                if (car.hitCooldown > 0) car.hitCooldown--;
            });

            policeHelicopter.update(player.x, player.y);

            policeCars.forEach(pCar => {
                pCar.update();
                const dist = Math.hypot(player.x - pCar.x, player.y - pCar.y);
                if (dist < 32) {
                    if (!pCar.hitCooldown || pCar.hitCooldown <= 0) {
                        pCar.hitCooldown = 30;
                        audio.playCrash();
                        player.speed = -player.speed * 0.7;
                        player.health = Math.max(0, player.health - 1);
                        updateHealthHUD();
                        showToast("🚨 被警車攔截！機會 -1");

                        if (player.health <= 0) {
                            const lostBooks = Math.ceil(player.books * 0.5);
                            player.books = Math.floor(player.books * 0.5);
                            showToast(`💔 機會耗盡！扣減 50% 書本 (-${lostBooks}本)，重置電單車！`);
                            setTimeout(() => {
                                player.health = player.maxHealth;
                                wantedLevel = 0;
                                policeCars.length = 0;
                                policeHelicopter.active = false;
                                updateWantedHUD();
                                updateHealthHUD();
                                updateBookHUD();
                                resetPlayer();
                            }, 1000);
                        }
                    }
                }
                if (pCar.hitCooldown > 0) pCar.hitCooldown--;
            });

            const displaySpeed = Math.min(100, Math.max(0, Math.round((Math.abs(player.speed) / (player.maxSpeed * 1.48)) * 100)));
            document.getElementById('hud-speed').innerText = `${displaySpeed} KM/H`;
        }

        function drawUltraDetailedMotorbike(ctx) {
            ctx.save();
            ctx.translate(player.x, player.y - player.jumpZ);
            ctx.rotate(player.angle);

            ctx.fillStyle = 'rgba(0, 0, 0, 0.45)';
            ctx.beginPath();
            ctx.ellipse(3 + player.jumpZ * 0.2, 3 + player.jumpZ * 0.2, 22, 9, 0, 0, Math.PI * 2);
            ctx.fill();

            ctx.rotate(player.leanAngle * 0.35);

            ctx.fillStyle = '#0f172a';
            ctx.fillRect(-22, -5, 12, 10);
            ctx.fillStyle = '#334155';
            ctx.fillRect(-20, -4, 2, 8);
            ctx.fillRect(-15, -4, 2, 8);

            ctx.fillStyle = '#0f172a';
            ctx.fillRect(12, -4, 10, 8);
            ctx.fillStyle = '#334155';
            ctx.fillRect(14, -3, 2, 6);
            ctx.fillRect(18, -3, 2, 6);

            ctx.fillStyle = '#94a3b8';
            ctx.fillRect(-16, 5, 18, 3);
            ctx.fillStyle = '#f1f5f9';
            ctx.fillRect(-18, 5, 4, 3);

            const bikeGrad = ctx.createLinearGradient(0, -8, 0, 8);
            bikeGrad.addColorStop(0, '#eab308');
            bikeGrad.addColorStop(0.5, '#ca8a04');
            bikeGrad.addColorStop(1, '#854d0e');

            ctx.fillStyle = bikeGrad;
            drawRoundRect(ctx, -12, -7, 24, 14, 4);
            ctx.fill();

            ctx.fillStyle = '#ffffff';
            ctx.fillRect(-6, -6, 12, 2);
            ctx.fillRect(-6, 4, 12, 2);

            ctx.fillStyle = '#1e293b';
            ctx.fillRect(-8, -4, 10, 8);

            ctx.fillStyle = '#475569';
            ctx.fillRect(4, -11, 3, 22);
            ctx.fillStyle = '#0f172a';
            ctx.fillRect(3, -12, 4, 3);
            ctx.fillRect(3, 9, 4, 3);

            ctx.fillStyle = '#18181b';
            drawRoundRect(ctx, -10, -5, 12, 10, 3);
            ctx.fill();

            ctx.fillStyle = '#dc2626';
            ctx.beginPath();
            ctx.arc(5, -9, 2.5, 0, Math.PI * 2);
            ctx.arc(5, 9, 2.5, 0, Math.PI * 2);
            ctx.fill();

            ctx.fillStyle = '#ef4444'; 
            ctx.beginPath();
            ctx.arc(-2, 0, 6.5, 0, Math.PI * 2);
            ctx.fill();

            ctx.fillStyle = '#38bdf8';
            ctx.beginPath();
            ctx.arc(1, 0, 5, -Math.PI/3, Math.PI/3);
            ctx.fill();
            ctx.fillStyle = '#ffffff';
            ctx.fillRect(0, -2, 2, 4);

            ctx.fillStyle = 'rgba(56, 189, 248, 0.7)';
            ctx.beginPath();
            ctx.moveTo(8, -5);
            ctx.lineTo(14, 0);
            ctx.lineTo(8, 5);
            ctx.closePath();
            ctx.fill();

            ctx.fillStyle = '#fef08a';
            ctx.beginPath();
            ctx.arc(15, 0, 3, 0, Math.PI * 2);
            ctx.fill();

            ctx.fillStyle = 'rgba(254, 240, 138, 0.22)';
            ctx.beginPath();
            ctx.moveTo(16, 0);
            ctx.lineTo(110, -35);
            ctx.lineTo(110, 35);
            ctx.closePath();
            ctx.fill();

            ctx.fillStyle = (keys.backward || keys.drift) ? '#ff0000' : '#dc2626';
            ctx.fillRect(-15, -3, 2, 6);
            if (keys.backward || keys.drift) {
                ctx.shadowColor = '#ff0000';
                ctx.shadowBlur = 12;
                ctx.fillRect(-18, -4, 4, 8);
                ctx.shadowBlur = 0;
            }

            ctx.restore();
        }

        function render() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            const camX = canvas.width / 2 - player.x;
            const camY = canvas.height / 2 - player.y;

            ctx.save();
            ctx.translate(camX, camY);

            const startC = Math.max(0, Math.floor((-camX) / TILE_SIZE));
            const endC = Math.min(MAP_SIZE, Math.ceil((-camX + canvas.width) / TILE_SIZE));
            const startR = Math.max(0, Math.floor((-camY) / TILE_SIZE));
            const endR = Math.min(MAP_SIZE, Math.ceil((-camY + canvas.height) / TILE_SIZE));

            // Draw Ground Map Tiles
            for (let r = startR; r < endR; r++) {
                for (let c = startC; c < endC; c++) {
                    const tile = cityGrid[r][c];
                    const tx = c * TILE_SIZE;
                    const ty = r * TILE_SIZE;

                    if (tile === TILE.ROAD) {
                        ctx.fillStyle = '#1e293b';
                        ctx.fillRect(tx, ty, TILE_SIZE, TILE_SIZE);
                        ctx.strokeStyle = '#334155';
                        ctx.lineWidth = 1;
                        ctx.strokeRect(tx, ty, TILE_SIZE, TILE_SIZE);
                    } else if (tile === TILE.SIDEWALK) {
                        ctx.fillStyle = '#475569';
                        ctx.fillRect(tx, ty, TILE_SIZE, TILE_SIZE);
                        ctx.strokeStyle = '#64748b';
                        ctx.lineWidth = 1;
                        ctx.strokeRect(tx, ty, TILE_SIZE, TILE_SIZE);
                    } else if (tile === TILE.PARK) {
                        ctx.fillStyle = '#15803d';
                        ctx.fillRect(tx, ty, TILE_SIZE, TILE_SIZE);
                    } else if (tile === TILE.RAMP) {
                        ctx.fillStyle = '#b45309';
                        ctx.fillRect(tx, ty, TILE_SIZE, TILE_SIZE);
                        ctx.fillStyle = '#f59e0b';
                        ctx.fillRect(tx + 10, ty + 10, TILE_SIZE - 20, TILE_SIZE - 20);
                    } else if (tile === TILE.SOCCER_PITCH) {
                        ctx.fillStyle = '#16a34a';
                        ctx.fillRect(tx, ty, TILE_SIZE, TILE_SIZE);
                    }
                }
            }

            policeHelicopter.drawGroundEffects(ctx);

            player.exhaustParticles.forEach(p => {
                ctx.fillStyle = p.color;
                ctx.globalAlpha = p.alpha;
                ctx.beginPath();
                ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
                ctx.fill();
                ctx.globalAlpha = 1.0;
            });

            bookPickups.forEach(p => {
                if (p.active) {
                    ctx.save();
                    ctx.translate(p.x, p.y);
                    const hoverY = Math.sin(p.pulse) * 6;
                    ctx.translate(0, hoverY);

                    const tilt = Math.sin(p.rotAngle) * 0.25;
                    ctx.rotate(tilt);

                    ctx.shadowColor = '#fbbf24';
                    ctx.shadowBlur = 14;

                    ctx.fillStyle = '#1e3a8a';
                    ctx.beginPath();
                    ctx.moveTo(0, -18);
                    ctx.quadraticCurveTo(-12, -20, -22, -15);
                    ctx.lineTo(-22, 16);
                    ctx.quadraticCurveTo(-12, 12, 0, 14);
                    ctx.closePath();
                    ctx.fill();

                    ctx.beginPath();
                    ctx.moveTo(0, -18);
                    ctx.quadraticCurveTo(12, -20, 22, -15);
                    ctx.lineTo(22, 16);
                    ctx.quadraticCurveTo(12, 12, 0, 14);
                    ctx.closePath();
                    ctx.fill();

                    ctx.strokeStyle = '#3b82f6';
                    ctx.lineWidth = 1.5;
                    ctx.stroke();

                    ctx.fillStyle = '#fffbeb';
                    ctx.beginPath();
                    ctx.moveTo(0, -16);
                    ctx.quadraticCurveTo(-10, -18, -19, -13);
                    ctx.lineTo(-19, 13);
                    ctx.quadraticCurveTo(-10, 9, 0, 11);
                    ctx.closePath();
                    ctx.fill();

                    ctx.beginPath();
                    ctx.moveTo(0, -16);
                    ctx.quadraticCurveTo(10, -18, 19, -13);
                    ctx.lineTo(19, 13);
                    ctx.quadraticCurveTo(10, 9, 0, 11);
                    ctx.closePath();
                    ctx.fill();

                    ctx.fillStyle = 'rgba(0, 0, 0, 0.15)';
                    ctx.beginPath();
                    ctx.moveTo(-2, -16);
                    ctx.lineTo(2, -16);
                    ctx.lineTo(3, 12);
                    ctx.lineTo(-3, 12);
                    ctx.closePath();
                    ctx.fill();

                    ctx.strokeStyle = '#d97706';
                    ctx.lineWidth = 1;
                    ctx.beginPath();
                    ctx.moveTo(0, -17);
                    ctx.lineTo(0, 13);
                    ctx.stroke();

                    ctx.strokeStyle = '#94a3b8';
                    ctx.lineWidth = 1;

                    ctx.beginPath();
                    ctx.moveTo(-15, -8); ctx.lineTo(-4, -6);
                    ctx.moveTo(-16, -2); ctx.lineTo(-4, 0);
                    ctx.moveTo(-15, 4);  ctx.lineTo(-4, 6);
                    ctx.stroke();

                    ctx.beginPath();
                    ctx.moveTo(4, -6); ctx.lineTo(15, -8);
                    ctx.moveTo(4, 0);  ctx.lineTo(16, -2);
                    ctx.moveTo(4, 6);  ctx.lineTo(15, 4);
                    ctx.stroke();

                    ctx.fillStyle = '#ef4444';
                    ctx.beginPath();
                    ctx.moveTo(0, 11);
                    ctx.lineTo(4, 22);
                    ctx.lineTo(0, 19);
                    ctx.lineTo(-4, 22);
                    ctx.closePath();
                    ctx.fill();

                    ctx.fillStyle = '#fef08a';
                    ctx.beginPath();
                    ctx.arc(0, -22, 2.5, 0, Math.PI * 2);
                    ctx.fill();

                    ctx.font = 'bold 12px "Noto Sans TC", sans-serif';
                    ctx.textAlign = 'center';
                    ctx.textBaseline = 'bottom';
                    ctx.fillStyle = '#fef08a';
                    ctx.shadowColor = '#000000';
                    ctx.shadowBlur = 6;
                    ctx.fillText(`${p.emoji || '📖'} ${p.title || ''}`, 0, -25);

                    ctx.shadowBlur = 0;
                    ctx.restore();
                }
            });

            trafficCars.forEach(car => car.draw());
            policeCars.forEach(car => car.draw());

            drawUltraDetailedMotorbike(ctx);

            const standardBuildings = buildingsList.filter(b => b.type !== 'school');
            const topLayerLandmarks = buildingsList.filter(b => b.type === 'school');

            const renderBuildingItem = (b) => {
                if (b.x + b.w < -camX || b.x > -camX + canvas.width || b.y + b.h < -camY || b.y > -camY + canvas.height) return;

                ctx.fillStyle = 'rgba(0,0,0,0.45)';
                ctx.fillRect(b.x + 8, b.y + 8, b.w, b.h);

                if (b.type === 'soccer_court') {
                    // 楓樹街遊樂場（16格大型足球場畫線與圖標）
                    ctx.fillStyle = '#15803d';
                    ctx.fillRect(b.x, b.y, b.w, b.h);
                    ctx.strokeStyle = '#ffffff';
                    ctx.lineWidth = 4;
                    ctx.strokeRect(b.x + 12, b.y + 12, b.w - 24, b.h - 24);

                    // 中央分界線
                    ctx.beginPath();
                    ctx.moveTo(b.x + 12, b.y + b.h / 2);
                    ctx.lineTo(b.x + b.w - 12, b.y + b.h / 2);
                    ctx.stroke();

                    // 中圈
                    ctx.beginPath();
                    ctx.arc(b.x + b.w/2, b.y + b.h/2, 60, 0, Math.PI * 2);
                    ctx.stroke();

                    // 上下兩端球門禁區
                    ctx.strokeRect(b.x + b.w/2 - 80, b.y + 12, 160, 70);
                    ctx.strokeRect(b.x + b.w/2 - 80, b.y + b.h - 82, 160, 70);

                    ctx.textAlign = 'center';
                    ctx.textBaseline = 'middle';
                    ctx.font = '48px "Noto Sans TC", sans-serif';
                    ctx.fillText('⚽', b.x + b.w/2, b.y + b.h/2 - 28);
                    ctx.fillStyle = '#ffffff';
                    ctx.shadowColor = '#000000';
                    ctx.shadowBlur = 8;
                    ctx.font = 'bold 36px "Noto Sans TC", sans-serif';
                    ctx.fillText(b.label, b.x + b.w/2, b.y + b.h/2 + 28);
                    ctx.shadowBlur = 0;

                } else if (b.type === 'school') {
                    ctx.fillStyle = b.color;
                    ctx.fillRect(b.x, b.y, b.w, b.h);
                    ctx.strokeStyle = '#f59e0b';
                    ctx.lineWidth = 4;
                    ctx.strokeRect(b.x, b.y, b.w, b.h);

                    ctx.textAlign = 'center';
                    ctx.textBaseline = 'middle';
                    ctx.font = '36px "Noto Sans TC", sans-serif';
                    ctx.fillText('🏫', b.x + b.w/2, b.y + b.h/2 - 20);
                    ctx.fillStyle = '#ffffff';
                    ctx.shadowColor = '#000000';
                    ctx.shadowBlur = 6;
                    ctx.font = 'bold 32px "Noto Sans TC", sans-serif';
                    ctx.fillText(b.label, b.x + b.w/2, b.y + b.h/2 + 20);
                    ctx.shadowBlur = 0;

                } else if (b.type === 'park') {
                    ctx.fillStyle = '#166534';
                    ctx.fillRect(b.x, b.y, b.w, b.h);
                    ctx.textAlign = 'center';
                    ctx.textBaseline = 'middle';
                    ctx.font = '34px "Noto Sans TC", sans-serif';
                    ctx.fillText('🌳', b.x + b.w/2, b.y + b.h/2 - 18);
                    ctx.fillStyle = '#86efac';
                    ctx.shadowColor = '#000000';
                    ctx.shadowBlur = 6;
                    ctx.font = 'bold 30px "Noto Sans TC", sans-serif';
                    ctx.fillText(b.label, b.x + b.w/2, b.y + b.h/2 + 18);
                    ctx.shadowBlur = 0;

                } else if (b.type === 'landmark') {
                    ctx.fillStyle = b.color;
                    ctx.fillRect(b.x, b.y, b.w, b.h);
                    ctx.strokeStyle = '#fef08a';
                    ctx.lineWidth = 4;
                    ctx.strokeRect(b.x, b.y, b.w, b.h);
                    
                    ctx.textAlign = 'center';
                    ctx.textBaseline = 'middle';
                    ctx.font = '42px "Noto Sans TC", sans-serif'; 
                    ctx.fillText(b.emoji, b.x + b.w/2, b.y + b.h/2 - 22);
                    ctx.fillStyle = '#ffffff';
                    ctx.shadowColor = '#000000';
                    ctx.shadowBlur = 6;
                    ctx.font = 'bold 38px "Noto Sans TC", sans-serif';
                    ctx.fillText(b.label, b.x + b.w/2, b.y + b.h/2 + 22);
                    ctx.shadowBlur = 0;

                } else {
                    ctx.fillStyle = b.color;
                    ctx.fillRect(b.x, b.y, b.w, b.h);
                    ctx.strokeStyle = '#0f172a';
                    ctx.lineWidth = 3;
                    ctx.strokeRect(b.x, b.y, b.w, b.h);

                    ctx.fillStyle = '#475569';
                    ctx.beginPath();
                    ctx.arc(b.x + 18, b.y + 18, 8, 0, Math.PI * 2);
                    ctx.fill();

                    if (b.label) {
                        ctx.textAlign = 'center';
                        ctx.textBaseline = 'middle';
                        const displayEmoji = b.emoji || '🏢';
                        ctx.font = '32px "Noto Sans TC", sans-serif';
                        ctx.fillText(displayEmoji, b.x + b.w/2, b.y + b.h/2 - 16);
                        
                        ctx.fillStyle = '#fef08a';
                        ctx.shadowColor = '#000000';
                        ctx.shadowBlur = 6;
                        ctx.font = 'bold 28px "Noto Sans TC", sans-serif';
                        ctx.fillText(b.label, b.x + b.w/2, b.y + b.h/2 + 16);
                        ctx.shadowBlur = 0;
                    }
                }
            };

            standardBuildings.forEach(renderBuildingItem);
            topLayerLandmarks.forEach(renderBuildingItem);

            policeHelicopter.drawHelicopter(ctx);

            ctx.restore();

            radarCtx.clearRect(0, 0, radarCanvas.width, radarCanvas.height);
            radarCtx.save();
            radarCtx.translate(65, 65);

            const scale = 0.042;

            bookPickups.forEach(p => {
                if (p.active) {
                    const rx = (p.x - player.x) * scale;
                    const ry = (p.y - player.y) * scale;
                    radarCtx.fillStyle = '#38bdf8';
                    radarCtx.fillRect(rx - 1.5, ry - 1.5, 3, 3);
                }
            });

            trafficCars.forEach(car => {
                const rx = (car.x - player.x) * scale;
                const ry = (car.y - player.y) * scale;
                radarCtx.fillStyle = (car.type === 'bus' || car.type === 'container') ? '#f59e0b' : '#94a3b8';
                radarCtx.fillRect(rx - 1, ry - 1, 2.5, 2.5);
            });

            policeCars.forEach(pCar => {
                const rx = (pCar.x - player.x) * scale;
                const ry = (pCar.y - player.y) * scale;
                const flashState = Math.floor(Date.now() / 150) % 2 === 0;
                radarCtx.fillStyle = flashState ? '#ef4444' : '#3b82f6';
                radarCtx.beginPath();
                radarCtx.arc(rx, ry, 3.5, 0, Math.PI * 2);
                radarCtx.fill();
            });

            radarCtx.rotate(player.angle);
            radarCtx.fillStyle = '#eab308';
            radarCtx.beginPath();
            radarCtx.moveTo(0, -6);
            radarCtx.lineTo(-4, 5);
            radarCtx.lineTo(4, 5);
            radarCtx.closePath();
            radarCtx.fill();

            radarCtx.restore();
        }

        function gameLoop() {
            updatePhysics();
            render();
            requestAnimationFrame(gameLoop);
        }

        window.onload = function() {
            gameLoop();
        };
    </script>
</body>
</html>
