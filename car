        function getRandomBook() {
            return bookTypes[Math.floor(Math.random() * bookTypes.length)];
        }

        const mouse = {
            x: window.innerWidth / 2,
            y: window.innerHeight / 2,
            activeMode: false
        };

        function generateShamShuiPoMap() {
            buildingsList.length = 0;
            bookPickups.length = 0;
            stuntRamps.length = 0;
            streetLabels.length = 0;

            // 建立基於 5-Tile 間距的真實街區網格系統 (包含道路、行人路與建築區)
            for (let r = 0; r < MAP_SIZE; r++) {
                cityGrid[r] = [];
                for (let c = 0; c < MAP_SIZE; c++) {
                    if (r === 0 || r === MAP_SIZE - 1 || c === 0 || c === MAP_SIZE - 1) {
                        cityGrid[r][c] = TILE.BUILDING; // 外圍空氣牆
                    } else if (r % 5 === 0 || c % 5 === 0) {
                        cityGrid[r][c] = TILE.ROAD; // 道路 (每隔 5 格一條主幹道)
                    } else if ((r % 5 === 2 || r % 5 === 3) && (c % 5 === 2 || c % 5 === 3)) {
                        cityGrid[r][c] = TILE.BUILDING; // 2x2 建築物核心區塊
                    } else {
                        cityGrid[r][c] = TILE.SIDEWALK; // 包圍建築的行人路
                    }
                }
            }

            // 真實深水埗街道名稱及精確格線坐標配置 (完美對應真實地圖順序)
            const realStreets = [
                // 橫向街道 (Horizontal Streets - Y軸)
                { name: "元州街 Un Chau St", r: 5, isHoriz: true },
                { name: "福榮街 Fuk Wing St (玩具圖書街)", r: 10, isHoriz: true },
                { name: "福華街 Fuk Wa St", r: 15, isHoriz: true },
                { name: "長沙灣道 Cheung Sha Wan Rd", r: 20, isHoriz: true },
                { name: "鴨寮街 Apliu St (電子街)", r: 25, isHoriz: true },
                { name: "汝州街 Yu Chau St", r: 30, isHoriz: true },
                { name: "基隆街 Ki Lung St", r: 35, isHoriz: true },
                { name: "大南街 Tai Nan St", r: 40, isHoriz: true },
                { name: "荔枝角道 Lai Chi Kok Rd", r: 45, isHoriz: true },
                { name: "醫局街 Yee Kuk St", r: 50, isHoriz: true },
                { name: "海壇街 Hoi Tan St", r: 55, isHoriz: true },

                // 縱向街道 (Vertical Streets - X軸)
                { name: "欽州街 Yen Chow St", c: 5, isHoriz: false },
                { name: "桂林街 Kweilin St", c: 10, isHoriz: false },
                { name: "北河街 Pei Ho St", c: 15, isHoriz: false },
                { name: "南昌街 Nam Cheong St", c: 20, isHoriz: false },
                { name: "石硤尾街 Shek Kip Mei St", c: 25, isHoriz: false },
                { name: "黃竹街 Wong Chuk St", c: 30, isHoriz: false },
                { name: "楓樹街 Maple St", c: 35, isHoriz: false },
                { name: "白楊街 Poplar St", c: 40, isHoriz: false },
                { name: "柏樹街 Cedar St", c: 45, isHoriz: false },
                { name: "界限街 Boundary St", c: 50, isHoriz: false },
                { name: "塘尾道 Tong Mi Rd", c: 55, isHoriz: false }
            ];

            realStreets.forEach(st => {
                streetLabels.push(st);
            });

            // 豐富真實深水埗著名大廈與民居地標名單及相配 Emoji
            const sspBuildingInfo = [
                { name: "深水埗各界慶典委員會", emoji: "🏮" },
                { name: "昌新大樓", emoji: "🏢" },
                { name: "福星大廈", emoji: "🏙️" },
                { name: "聯昌大樓", emoji: "🏢" },
                { name: "深崇閣", emoji: "🏬" },
                { name: "宇宙大廈", emoji: "🚀" },
                { name: "麗華大廈", emoji: "🏢" },
                { name: "怡家大樓", emoji: "🏠" },
                { name: "祥興大樓", emoji: "🏢" },
                { name: "金華樓", emoji: "✨" },
                { name: "龍慶堂", emoji: "🐉" },
                { name: "汝州大廈", emoji: "🏢" },
                { name: "桂林大廈", emoji: "🏙️" },
                { name: "欽州大廈", emoji: "🏬" },
                { name: "太安樓", emoji: "🕊️" },
                { name: "順利大廈", emoji: "🍀" },
                { name: "富裕大樓", emoji: "💰" },
                { name: "華麗大廈", emoji: "💎" },
                { name: "永明大廈", emoji: "☀️" },
