        const cityGrid = [];
        const buildingsList = [];
        const bookPickups = [];
        const stuntRamps = [];
        const streetLabels = [];

        const bookTypes = [
            { name: "三國志", emoji: "⚔️" },
            { name: "西遊記", emoji: "🐵" },
