        class TrafficCar {
            constructor(x, y, isPolice = false) {
                this.x = x;
                this.y = y;
                this.angle = (Math.floor(Math.random() * 4) * Math.PI) / 2;
                this.isPolice = isPolice;
                this.sirenTimer = Math.random() * 10;
                
                const types = ['sedan', 'tesla', 'bus', 'truck', 'container', 'motorcycle', 'scooter'];
                this.type = isPolice ? 'police' : types[Math.floor(Math.random() * types.length)];

                if (this.isPolice) {
                    this.width = 24;
                    this.length = 46;
                    this.speed = 6.16;
                    this.color = '#1e3a8a';
                } else if (this.type === 'bus') {
