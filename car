    <script>
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');
        const radarCanvas = document.getElementById('radarCanvas');
        const radarCtx = radarCanvas.getContext('2d');

        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        function drawRoundRect(context, x, y, width, height, radius) {
            context.beginPath();
            if (typeof context.roundRect === 'function') {
                context.roundRect(x, y, width, height, radius);
            } else {
                context.rect(x, y, width, height);
            }
        }

        class SoundEngine {
            constructor() {
                this.ctx = null;
                this.engineOsc = null;
                this.engineGain = null;
                this.isAudioStarted = false;
                this.radioIndex = 0;
                this.radioStations = [
                    { name: "HEAD RADIO 98.3", tempo: 128, baseFreq: 110 },
                    { name: "K-JAH RETRO DUB", tempo: 90, baseFreq: 65 },
                    { name: "ZAIBATSU SYNTHWAVE", tempo: 135, baseFreq: 140 },
                    { name: "RADIO OFF", tempo: 0, baseFreq: 0 }
                ];
                this.radioTimer = null;
            }

            init() {
                if (this.isAudioStarted) return;
                try {
                    const AudioCtx = window.AudioContext || window.webkitAudioContext;
                    this.ctx = new AudioCtx();

                    this.engineOsc = this.ctx.createOscillator();
                    this.engineGain = this.ctx.createGain();

                    this.engineOsc.type = 'sawtooth';
                    this.engineOsc.frequency.setValueAtTime(60, this.ctx.currentTime);
                    this.engineGain.gain.setValueAtTime(0.04, this.ctx.currentTime);

                    const filter = this.ctx.createBiquadFilter();
                    filter.type = 'lowpass';
                    filter.frequency.setValueAtTime(450, this.ctx.currentTime);

                    this.engineOsc.connect(filter);
                    filter.connect(this.engineGain);
                    this.engineGain.connect(this.ctx.destination);

                    this.engineOsc.start();
                    this.isAudioStarted = true;
                    this.startRadioBeat();
                } catch(e) {
                    console.log("Audio Context Error:", e);
                }
            }

            updateEngineSound(speedRatio, isAccelerating) {
                if (!this.isAudioStarted || !this.ctx) return;
                const now = this.ctx.currentTime;
                const targetFreq = 55 + speedRatio * 200 + (isAccelerating ? 35 : 0);
                const targetGain = 0.02 + speedRatio * 0.07 + (isAccelerating ? 0.03 : 0);

                this.engineOsc.frequency.setTargetAtTime(targetFreq, now, 0.05);
                this.engineGain.gain.setTargetAtTime(targetGain, now, 0.08);
            }

            playCrash() {
                if (!this.isAudioStarted || !this.ctx) return;
                const now = this.ctx.currentTime;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();

                osc.type = 'square';
                osc.frequency.setValueAtTime(140, now);
                osc.frequency.exponentialRampToValueAtTime(30, now + 0.25);

                gain.gain.setValueAtTime(0.3, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.25);

                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start();
                osc.stop(now + 0.25);
            }

            playHorn() {
                if (!this.isAudioStarted || !this.ctx) return;
                const now = this.ctx.currentTime;
                const osc1 = this.ctx.createOscillator();
                const osc2 = this.ctx.createOscillator();
                const gain = this.ctx.createGain();

                osc1.type = 'triangle';
                osc2.type = 'triangle';
                osc1.frequency.setValueAtTime(440, now);
                osc2.frequency.setValueAtTime(554, now);

                gain.gain.setValueAtTime(0.2, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.4);

                osc1.connect(gain);
                osc2.connect(gain);
                gain.connect(this.ctx.destination);

                osc1.start(); osc2.start();
                osc1.stop(now + 0.4); osc2.stop(now + 0.4);
            }

            playBookSound() {
                if (!this.isAudioStarted || !this.ctx) return;
                const now = this.ctx.currentTime;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();

                osc.type = 'sine';
                osc.frequency.setValueAtTime(523.25, now);
                osc.frequency.setValueAtTime(659.25, now + 0.07);
                osc.frequency.setValueAtTime(783.99, now + 0.14);

                gain.gain.setValueAtTime(0.25, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.3);

                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start();
                osc.stop(now + 0.3);
            }

            nextRadio() {
                this.radioIndex = (this.radioIndex + 1) % this.radioStations.length;
                this.startRadioBeat();
                return this.radioStations[this.radioIndex].name;
            }

            prevRadio() {
                this.radioIndex = (this.radioIndex - 1 + this.radioStations.length) % this.radioStations.length;
                this.startRadioBeat();
                return this.radioStations[this.radioIndex].name;
            }

            startRadioBeat() {
                if (this.radioTimer) clearInterval(this.radioTimer);
                const station = this.radioStations[this.radioIndex];
                if (station.tempo === 0 || !this.isAudioStarted || !this.ctx) return;

                let beatStep = 0;
                const interval = (60 / station.tempo) * 1000 / 2;

                this.radioTimer = setInterval(() => {
                    if (!this.isAudioStarted || !this.ctx) return;
                    const now = this.ctx.currentTime;
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();

                    osc.type = beatStep % 2 === 0 ? 'sine' : 'triangle';
                    const freq = station.baseFreq * (beatStep % 4 === 0 ? 1 : beatStep % 4 === 2 ? 1.5 : 1.25);
                    osc.frequency.setValueAtTime(freq, now);

                    gain.gain.setValueAtTime(0.03, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.12);

                    osc.connect(gain);
                    gain.connect(this.ctx.destination);
                    osc.start();
                    osc.stop(now + 0.12);

                    beatStep++;
                }, interval);
            }
        }

        const audio = new SoundEngine();

        const TILE_SIZE = 120;
        const MAP_SIZE = 60; // 擴大地圖尺寸以容納更精確的深水埗真實路網
        const WORLD_BOUNDS = MAP_SIZE * TILE_SIZE;

        const TILE = {
            ROAD: 0,
            SIDEWALK: 1,
            BUILDING: 2,
            PARK: 3,
            RAMP: 4,
            SOCCER_PITCH: 5
