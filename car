                    this.color = ['#f8fafc', '#0f172a', '#dc2626', '#3b82f6'][Math.floor(Math.random() * 4)];
                } else if (this.type === 'motorcycle') {
                    this.width = 14;
                    this.length = 32;
                    this.speed = 3.0 + Math.random() * 1.8;
                    this.color = ['#f59e0b', '#10b981', '#ef4444'][Math.floor(Math.random() * 3)];
                } else if (this.type === 'scooter') {
                    this.width = 14;
                    this.length = 26;
                    this.speed = 2.2 + Math.random() * 1.2;
                    this.color = ['#ec4899', '#06b6d4', '#84cc16', '#a855f7'][Math.floor(Math.random() * 4)];
                } else { 
                    this.width = 24;
                    this.length = 46;
                    this.speed = 2.2 + Math.random() * 1.5;
                    this.color = ['#ef4444', '#3b82f6', '#10b981', '#f59e0b', '#8b5cf6'][Math.floor(Math.random()*5)];
                }
            }

            update() {
                if (this.isPolice) {
                    if (Date.now() < policeFreezeEndTime) {
                        return;
                    }

                    const dx = player.x - this.x;
                    const dy = player.y - this.y;
                    const targetAngle = Math.atan2(dy, dx);
                    
                    let diff = targetAngle - this.angle;
                    while (diff < -Math.PI) diff += Math.PI * 2;
                    while (diff > Math.PI) diff -= Math.PI * 2;
                    this.angle += Math.sign(diff) * Math.min(Math.abs(diff), 0.05);

                    this.sirenTimer += 0.25;
                } else {
                    const lookX = this.x + Math.cos(this.angle) * (this.length / 2 + 20);
                    const lookY = this.y + Math.sin(this.angle) * (this.length / 2 + 20);
                    const tileC = Math.floor(lookX / TILE_SIZE);
                    const tileR = Math.floor(lookY / TILE_SIZE);

                    if (tileC < 1 || tileC >= MAP_SIZE - 1 || tileR < 1 || tileR >= MAP_SIZE - 1 || cityGrid[tileR][tileC] === TILE.BUILDING) {
                        this.angle += Math.PI / 2;
                    }
                }

                this.x += Math.cos(this.angle) * this.speed;
                this.y += Math.sin(this.angle) * this.speed;
            }

            draw() {
                ctx.save();
                ctx.translate(this.x, this.y);
                ctx.rotate(this.angle);

                ctx.fillStyle = 'rgba(0, 0, 0, 0.35)';
                ctx.fillRect(-this.length/2 + 3, -this.width/2 + 3, this.length, this.width);

                if (this.isPolice) {
                    ctx.fillStyle = '#0f172a';
                    drawRoundRect(ctx, -this.length/2, -this.width/2, this.length, this.width, 5);
                    ctx.fill();

                    ctx.fillStyle = '#1e3a8a';
                    drawRoundRect(ctx, -this.length/2 + 1, -this.width/2 + 1, this.length - 2, this.width - 2, 4);
                    ctx.fill();

                    ctx.fillStyle = '#f8fafc';
                    ctx.fillRect(this.length*0.1, -this.width/2 + 2, this.length*0.3, this.width - 4);

                    const isAlt = Math.floor(this.sirenTimer * 4) % 2 === 0;
                    ctx.fillStyle = isAlt ? '#ef4444' : '#3b82f6';
                    ctx.fillRect(-2, -this.width*0.35, 4, this.width*0.7);

                } else if (this.type === 'bus') {
                    ctx.fillStyle = this.color;
                    drawRoundRect(ctx, -this.length/2, -this.width/2, this.length, this.width, 4);
                    ctx.fill();

                    ctx.fillStyle = '#f8fafc';
                    drawRoundRect(ctx, -10, -this.width/2 + 4, 25, this.width - 8, 2);
                    ctx.fill();

                    ctx.fillStyle = '#0f172a';
                    ctx.fillRect(-this.length/2 + 4, -this.width/2 + 2, this.length - 8, 2);
                    ctx.fillRect(-this.length/2 + 4, this.width/2 - 4, this.length - 8, 2);

                    ctx.fillStyle = '#000000';
                    ctx.fillRect(this.length/2 - 6, -this.width/2 + 5, 4, this.width - 10);
                    ctx.fillStyle = '#f59e0b';
                    ctx.fillRect(this.length/2 - 5, -this.width/2 + 7, 2, this.width - 14);

                } else if (this.type === 'container') {
                    ctx.fillStyle = this.color;
                    drawRoundRect(ctx, this.length/2 - 22, -this.width/2 + 1, 20, this.width - 2, 3);
                    ctx.fill();
                    ctx.fillStyle = '#1e293b';
                    ctx.fillRect(this.length/2 - 12, -this.width/2 + 3, 6, this.width - 6);

                    ctx.fillStyle = this.containerColor;
                    drawRoundRect(ctx, -this.length/2, -this.width/2, this.length - 24, this.width, 3);
                    ctx.fill();
                    ctx.fillStyle = 'rgba(0, 0, 0, 0.2)';
                    for (let x = -this.length/2 + 6; x < this.length/2 - 28; x += 6) {
                        ctx.fillRect(x, -this.width/2 + 2, 2, this.width - 4);
                    }

                } else if (this.type === 'truck') {
                    ctx.fillStyle = this.boxColor;
                    drawRoundRect(ctx, -this.length/2, -this.width/2, this.length - 16, this.width, 3);
                    ctx.fill();

                    ctx.fillStyle = this.color;
                    drawRoundRect(ctx, this.length/2 - 14, -this.width/2 + 1, 13, this.width - 2, 3);
                    ctx.fill();
                    ctx.fillStyle = '#1e293b';
                    ctx.fillRect(this.length/2 - 8, -this.width/2 + 3, 4, this.width - 6);

                } else if (this.type === 'tesla') {
                    ctx.fillStyle = this.color;
                    drawRoundRect(ctx, -this.length/2, -this.width/2, this.length, this.width, 7);
                    ctx.fill();

                    ctx.fillStyle = '#020617';
                    drawRoundRect(ctx, -this.length/4, -this.width/2 + 3, this.length/2, this.width - 6, 4);
                    ctx.fill();

                    ctx.fillStyle = '#e0f2fe';
                    ctx.fillRect(this.length/2 - 3, -this.width/2 + 2, 2, this.width - 4);

                } else if (this.type === 'motorcycle') {
                    ctx.fillStyle = this.color;
                    drawRoundRect(ctx, -this.length/2, -3, this.length, 6, 2);
                    ctx.fill();
                    ctx.fillStyle = '#fef08a';
                    ctx.fillRect(this.length/2 - 2, -2, 2, 4);
                    ctx.fillStyle = '#0f172a';
                    ctx.beginPath();
                    ctx.arc(0, 0, 4.5, 0, Math.PI * 2);
                    ctx.fill();

                } else if (this.type === 'scooter') {
                    ctx.fillStyle = this.color;
                    drawRoundRect(ctx, -this.length/2, -this.width/2, this.length, this.width, 6);
                    ctx.fill();
                    ctx.fillStyle = '#38bdf8';
                    ctx.fillRect(this.length/2 - 5, -this.width/2 + 3, 3, this.width - 6);
                    ctx.fillStyle = '#fef08a';
                    ctx.beginPath();
                    ctx.arc(this.length/2 - 1, 0, 3, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.fillStyle = '#ffffff';
                    ctx.beginPath();
                    ctx.arc(-2, 0, 4, 0, Math.PI * 2);
                    ctx.fill();

                } else { 
                    ctx.fillStyle = this.color;
                    drawRoundRect(ctx, -this.length/2, -this.width/2, this.length, this.width, 5);
                    ctx.fill();

                    ctx.fillStyle = '#0f172a';
                    ctx.fillRect(-this.length*0.1, -this.width*0.35, this.length*0.4, this.width*0.7);
                }

                ctx.restore();
            }
        }

